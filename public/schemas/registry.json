{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/registry.json",
  "title": "Coordiation open-code registry",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "homepage": { "type": "string" },
    "items": { "type": "array", "items": { "$ref": "registry-item.json" } }
  },
  "additionalProperties": true
}
